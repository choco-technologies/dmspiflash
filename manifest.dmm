# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/dmspiflash/releases/download/vlatest/versions.dmm

# Module entry with version placeholder - expanded by $version-available.
# <arch_name>: the release workflow packages this repo per architecture (dmspiflash-v<version>-armv7-cortex-m7.zip, ...),
# not per CPU family (dmqspi has ports, so its packages are per family).
dmspiflash https://github.com/choco-technologies/dmspiflash/releases/download/v<version>/dmspiflash-v<version>-<arch_name>.zip
